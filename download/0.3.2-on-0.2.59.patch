+    const sugs = await db.suggestion.findMany({
+      where: { outcome: { not: null }, pnlPct: { not: null }, bias: { not: "NEUTRAL" } },
+      orderBy: { createdAt: "desc" },
+      take: TAKE_SUGS,
+      select: { auc: true, acc: true, prob: true, confidence: true, pnlPct: true },

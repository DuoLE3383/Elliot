# Copy this file to .env and adjust as needed
# SQLite file database (folder db/ is git-ignored, created on first run)
DATABASE_URL="file:./db/custom.db"

# ── Telegram (CÁCH DUY NHẤT để cấu hình thông báo) ────────────────────────
# Điền đủ 2 dòng dưới đây thì bot + kênh hoạt động ngay sau khi restart.
# Đổi token/kênh = sửa 2 dòng này (hoặc chạy deploy/set-telegram-env.sh) + restart.
#   • TELEGRAM_BOT_TOKEN: token từ @BotFather (dạng 123456789:AAE…)
#   • TELEGRAM_CHAT_ID:   id kênh (-100…) HOẶC link/name kênh public —
#       https://t.me/airealtime, @airealtime, airealtime đều được (app tự chuyển
#       thành @airealtime). Kênh RIÊNG (private) phải dùng id -100…: thêm bot
#       làm admin kênh rồi lấy id qua Telegram Bot API (getUpdates/getChat)
#   • TELEGRAM_API_BASE:  LUÔN để trống trừ khi bạn thật sự có proxy Bot API
#       (Cloudflare Worker — DEPLOY.md §6b). KHÔNG bao giờ điền localhost:3000
#       (đó là app tự gọi chính nó → lỗi "fetch failed"; bản mới tự bỏ qua giá trị này)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE=

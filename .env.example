# Copy this file to .env and adjust as needed
# SQLite file database (folder db/ is git-ignored, created on first run)
DATABASE_URL="file:./db/custom.db"

# ── Telegram (TÙY CHỌN — nhét cứng để khỏi cấu hình trong app) ──────────────
# Điền đủ 2 dòng dưới đây thì bot + kênh hoạt động ngay sau khi restart,
# không cần dán token trong panel Auto. Panel sẽ hiện badge ".env".
#   • TELEGRAM_BOT_TOKEN: token từ @BotFather (dạng 123456789:AAE…)
#   • TELEGRAM_CHAT_ID:   id kênh/supergroup nhận thông báo (dạng -100…)
#       → lấy id: thêm bot làm admin kênh → forward 1 bài trong kênh cho bot
#         → panel Auto → "Tìm kênh" → id hiện ra
#   • TELEGRAM_API_BASE:  để trống = api.telegram.org chính chủ; nếu VPS bị
#     503/429 dai dẳng thì dùng URL Cloudflare Worker proxy (DEPLOY.md §6b)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_API_BASE=

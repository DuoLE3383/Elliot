// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── Elliott terminal — XGBoost suggestions & finetune history ──────────────
// One row per (pair, interval, time) — every train produces a finetune run
// AND a strategy suggestion; outcomes are scored once the horizon expires.

model Suggestion {
  id          String    @id @default(cuid())
  symbol      String // e.g. BTCUSDT
  interval    String // e.g. 5m
  bias        String // LONG | SHORT | NEUTRAL
  prob        Float // P(price up at horizon), 0..1
  confidence  Float // |2p−1|, 0..1
  slPct       Float
  tpPct       Float
  atrKey      Float
  atrPeriod   Int
  smaFilter   Boolean
  smaPeriod   Int
  acc         Float // model accuracy at train time, %
  auc         Float // model AUC at train time, 0..1
  horizonBars Int // prediction horizon (bars ahead)
  entryPrice  Float // close of the last closed candle when suggested
  applied     Boolean   @default(false)
  appliedAt   DateTime?
  outcome     String? // null = pending; win | loss | flat
  exitPrice   Float?
  pnlPct      Float? // signed % move in the suggested direction
  resolvedAt  DateTime?
  createdAt   DateTime  @default(now())

  @@index([symbol, interval, createdAt])
  @@index([outcome])
}

model FinetuneRun {
  id         String   @id @default(cuid())
  symbol     String
  interval   String
  kind       String   @default("train") // train | finetune
  samples    Int
  valSamples Int
  acc        Float
  auc        Float
  logloss    Float
  trees      Int
  horizon    Int
  importance String // JSON [{name, gain}]
  params     String // JSON XgbParams
  applied    Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([symbol, interval, createdAt])
}

// ─── Auto trade (dry-run) — one row per opened position ─────────────────────
// The auto engine scans every watched pair × timeframe, ranks them by the
// XGBoost model's predicted win quality (auc/acc/confidence) and opens ONE
// paper position at a time on the best candidate with a virtual capital.

model AutoTrade {
  id            String    @id @default(cuid())
  symbol        String
  interval      String
  side          String // LONG | SHORT
  entryPrice    Float
  entryTime     DateTime  @default(now())
  slPct         Float
  tpPct         Float
  leverage      Float     @default(1)
  /** share of equity staked on this trade, % (100 = all-in) */
  stakePct      Float     @default(100)
  status        String    @default("open") // open | closed
  exitPrice     Float?
  exitTime      DateTime?
  /** signed ROE % = price move × leverage (liquidation-safe) */
  pnlPct        Float?
  exitKind      String? // tp | sl | manual
  prob          Float?
  acc           Float?
  auc           Float?
  score         Float?
  capitalBefore Float?
  capitalAfter  Float?
  /** verdict của LLM Risk Officer LÚC VÀO LỆNH — go | skip | unreachable;
   *  null = lệnh mở trước 0.2.28 hoặc không qua LLM. Đi kèm autopsy để nhìn
   *  lại "risk officer duyệt go mà lệnh vẫn thua" một cách khách quan. */
  llmVerdict    String?
  /** lý do đầu tiên của verdict lúc vào lệnh (≤180 ký tự) */
  llmReason     String?
  /** JSON giải phẫu lệnh (autopsy) sau khi ĐÓNG — {outcome, tag, why[], lesson,
   *  ev:{mfePct,maePct,rMultiple,durMin,noisePct,candles,covered}, ms, model, at}.
   *  Cả lệnh thắng lẫn thua đều được mổ; lesson được nạp lại vào prompt duyệt
   *  các lệnh sau của cùng cặp (vòng học khép kín). */
  autopsy       String?
  /** fingerprint of entry policy (gates/stake/lev/TF) at open — self-improve agent */
  methodId      String?
  createdAt     DateTime  @default(now())

  @@index([status, createdAt])
  @@index([methodId])
  @@index([symbol, interval])
}

// ─── Dry-run wallet — vốn gốc của sổ paper-trade (0.2.86) ────────────────────
// Trước đây vốn chỉ SỐNG TRONG chuỗi capitalAfter của các lệnh: xoá sổ (reset)
// là vốn thành null, UI hiện "?" và lệnh kế phải đoán lại từ cfg của panel.
// Một dòng duy nhất (id "wallet") ghi vốn sau lần reset gần nhất — readAutoState
// dùng làm fallback khi sổ trống, nên "Reset vốn" thấy tiền NGAY, sống qua
// pm2 restart, và chuỗi equity lệnh mới bắt đầu đúng từ con số đó.

model DryRunState {
  id       String   @id // luôn "wallet" — bảng một dòng
  capital  Float // vốn đã đặt sau lần reset gần nhất (USDT)
  resetAt  DateTime @default(now())
  note     String   @default("") // nguồn đặt vốn: "panel" | "api" | …
}

// ─── Broadcast verdict — MỘT thuật toán gate dùng chung panel + Telegram ─────
// Mỗi 5 phút broadcast tick chấm TẤT CẢ combo quét qua đúng một hàm
// bcast-gate.gateRow() và upsert phán quyết vào đây (một dòng / combo).
// Telegram chỉ đăng combo verdict "pass"; panel đọc CÙNG bảng này qua
// GET /api/engine → "bcast" — không thể lệch nhau vì chỉ có một thuật toán.

model BcastVerdict {
  id       String   @id @default(cuid())
  symbol   String
  interval String
  side     String // LONG | SHORT | NEUTRAL
  score    Float
  auc      Float
  acc      Float
  verdict  String // pass | reject
  reason   String // "" khi pass; "điểm 52.1 < 70", "AUC 0.63 < 0.8", "cooldown còn 42p"…
  at       DateTime @default(now())

  @@unique([symbol, interval])
  @@index([verdict])
}

// ─── Dive report — LƯU LẠI bài phân tích LLM ("Vạch lá tìm sâu") ─────────────
// Trước 0.2.36 mỗi lần dive chạy xong chỉ hiện trên UI rồi mất (route ghi rõ
// "KHÔNG ghi DB"). Từ bản này mỗi lần chạy — kể cả fail — được lưu một dòng để
// soi dọc theo thời gian: win-rate hôm nay LLM nói gì, tuần sau nó đổi ý chưa.
model DiveReport {
  id        String   @id @default(cuid())
  source    String // "stats-dive" | … (tương lai: autopsy-digest, lab-audit…)
  model     String // tên model LLM đã trả
  ok        Boolean // LLM trả lời thành công?
  ms        Int // thời gian chạy
  text      String // markdown đầu ra của LLM
  detail    String? // chi tiết lỗi khi !ok
  createdAt DateTime @default(now())

  @@index([source, createdAt])
}

// ─── Strategy variant — MỘT ỨNG VIÊN CHIẾN LƯỢC trong Strategy Lab ───────────
// Mỗi lần "sinh chiến lược" (thủ công hoặc tự động sau train, throttle 12h),
// server dựng baseline = cfg hiện tại + grid SL/TP·UT·SMA + các biến thể ĐỊNH
// HƯỚNG theo feature gain của champion run (importance đã lưu trong
// FinetuneRun), rồi backtest TẤT CẢ trên klines thật bằng đúng thuật toán
// engine (signalsFrom → papersFrom → kpiFrom). Cả thắng lẫn thua đều sống lại
// trong bảng này → A/B thật, không phải greedy top-1 như suggestFrom cũ.
model StrategyVariant {
  id            String    @id @default(cuid())
  symbol        String
  interval      String
  name          String // tên ngắn, vd "ATR nới 2.5×"
  hypothesis    String // giả thuyết tiếng Việt — dựa yếu tố nào, chờ điều gì
  sourceFeature String    @default("") // feature gain chính, "" = grid/quét
  config        String // JSON LabConfig {slPct,tpPct,atrKey,atrPeriod,smaFilter,smaPeriod,leverage}
  baseline      Boolean   @default(false) // mốc so sánh = cfg đang chạy
  scored        Boolean   @default(false) // đã backtest chưa
  metrics       String? // JSON LabMetrics {trades,winRate,netPnl,expectancy,maxDd,…}
  applied       Boolean   @default(false)
  appliedAt     DateTime?
  createdAt     DateTime  @default(now())
  scoredAt      DateTime?

  @@index([symbol, interval, createdAt])
}

// ─── Signal total — đếm TÍCH LUỸ tín hiệu server đã quét thấy ────────────────
// Mỗi lượt quét engine (scanCore), mọi combo model bật hướng LONG/SHORT (≠
// NEUTRAL) cộng 1. Đây là "tổng tín hiệu" trên KPI "Signals this window" —
// số trong khung nến tính phía trình duyệt (signalsFrom), số này đếm suốt
// đời server, sống qua pm2 restart nhờ DB.

model SignalTotal {
  symbol    String
  interval  String
  total     Int      @default(0)
  updatedAt DateTime @updatedAt

  @@id([symbol, interval])
}

// ─── Improve event — self-improve agent log (24/7) ───────────────────────────
// measure | discover | promote | rollback | skip — numeric policy decisions.
model ImproveEvent {
  id        String   @id @default(cuid())
  kind      String // measure | discover | promote | rollback | skip
  methodId  String   @default("")
  detail    String // JSON payload
  note      String   @default("")
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
  @@index([createdAt])
}

// ─── Evolve log — nhật ký vòng "tự tiến hoá" (0.2.54) ────────────────────────
// Vòng khép kín trên nền Strategy Lab: sinh ứng viên từ dữ liệu đang tích hợp
// (feature importance của champion + grid) và đề xuất LLM → backtest đúng
// thuật toán engine trên nến thật → áp kẻ thắng vào settings engine → theo dõi
// hiệu quả trên lệnh giấy THẬT (AutoTrade đóng sau thời điểm áp) → tự hoàn tác
// nếu tệ hơn mốc. Mỗi quyết định 1 dòng: promote (áp) / keep (không đạt biên)
// / confirm (qua theo dõi) / revert (hoàn tác) / error.
model EvolveLog {
  id        String   @id @default(cuid())
  combo     String // "BTCUSDT 15m" — combo đại diện dùng cho backtest
  decision  String // promote | keep | confirm | revert | error
  name      String   @default("") // ứng viên áp/hủy — "" với keep/error
  detail    String   @default("") // giải thích tiếng Việt + số liệu chính
  cfgBefore String   @default("") // JSON LabConfig trước khi đổi
  cfgAfter  String   @default("") // JSON LabConfig sau khi đổi
  metrics   String? // JSON { base, best, watch? } — LabMetrics + số theo dõi
  createdAt DateTime @default(now())

  @@index([createdAt])
}

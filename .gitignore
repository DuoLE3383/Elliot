# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log
# chỉ ignore thư mục test ở GỐC repo — pattern `test` trần trụi sẽ nuốt cả
# src/app/api/llm/test/ (đã gây 404 /api/llm/test trên VPS trên mọi build!)
/test
prompt

server.log
# Skills directory
/skills/upload/

# local runtime data & secrets (never push)
db/
data/

# local tooling / workspace-only dirs
skills/
.zscripts/
upload/

# but keep the example file
!.env.example
tool-results/
download/

# generated per-build marker (write-build-id.mjs) — never commit
/public/build-id.txt
package-lock.json

# patch/backup nội bộ — không bao giờ vào repo
/.backup/

# Wyckoff verification scratch (sandbox-only, không gửi repo)
/wyckoff/
scripts/wyckoff-cache/
scripts/wyckoff_crypto_*.csv
